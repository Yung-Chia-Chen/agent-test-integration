# Ollama API Configuration (語言模型和視覺模型)
OPENAI_BASE_URL=https://ollama.com/v1
OPENAI_API_KEY=your-ollama-api-key-here
OPENAI_MODEL_NAME=gpt-oss:120b-cloud

# RAGFlow Configuration
RAGFLOW_BASE_URL=http://your-ragflow-host:2120
RAGFLOW_API_KEY=your-ragflow-api-key-here
RAGFLOW_KB_ID=your-knowledge-base-id-here
RAGFLOW_TOP_K=200
RAGFLOW_SIMILARITY_THRESHOLD=0.1

# Rerank 增強檢索配置
USE_RERANK=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# Ollama Configuration (視覺辨識模型)
OLLAMA_HOST=ollama.com
OLLAMA_VISION_MODEL=qwen3-vl:235b-cloud

# NextAuth Configuration
AUTH_SECRET=generate-a-random-secret-key-here
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Database (Optional - for guest mode, can be empty)
POSTGRES_URL=

# Node.js
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
